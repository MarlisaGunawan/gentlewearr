# Laravel API (n8n calls it for the daily recap)
GW_API_URL=http://localhost:8000/api
# Must be the same value as N8N_API_TOKEN in backend/.env
GW_N8N_TOKEN=change-me-to-a-long-random-string

# Telegram: token from @BotFather, and the chat id of the admin (or a group) that gets alerts.
# Chat id: send any message to your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email through Brevo (https://app.brevo.com → SMTP & API → API keys, starts with xkeysib-)
BREVO_API_KEY=
# Sender: must be a sender/domain verified in Brevo (Senders, domains & dedicated IPs)
SHOP_NAME=Gentle Wear
SHOP_EMAIL=no-reply@example.com
# Where staff alerts and the daily recap go
NOTIFY_EMAIL=owner@example.com
