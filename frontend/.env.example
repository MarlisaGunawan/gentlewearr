# Base URL of the 8 hero clips (must end with a slash).
# Leave empty to use the default remote (Cloudflare R2) clips.
# Use /videos/ for the clips in public/videos, or /test-videos/ for plain placeholders.
VITE_MEDIA_BASE=/videos/

# Laravel API. Leave empty to run the shop on bundled demo data (no admin, mock payments).
# The Midtrans client key comes from the backend at checkout — no payment keys here.
VITE_API_URL=http://localhost:8000/api
